# ---- Vision + recipe generation (server-side only, never exposed to the client) ----
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used for photo analysis (defaults to claude-opus-5)
# ANTHROPIC_MODEL=

# ---- Supabase (optional -- without it the app stores everything on-device) ----
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL
# editor, then enable anonymous sign-ins under Authentication -> Providers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security, used to record product analytics.
# NEVER give this a NEXT_PUBLIC_ prefix -- that would publish full database
# access to every visitor. Found under Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
