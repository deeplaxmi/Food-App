# ---- Vision + recipe generation (server-side only, never exposed to the client) ----
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Supabase (optional for local development) ----
# Without these the app stores everything in the browser (on-device mode).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
